{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nexus Tracker",
  "version": "1.0.0",
  "identifier": "com.shefa.nexus-tracker",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "visible": false,
        "width": 1,
        "height": 1
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}